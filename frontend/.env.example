NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional. Set this only when the Next.js server should reach the backend by a
# private address, for example http://127.0.0.1:5000/api when both run on one
# VPS. Left unset, the server uses NEXT_PUBLIC_API_URL.
# API_URL=
AUTH_RELAY_SECRET=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=

# Publishable key id only. The Razorpay secret stays on the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Review login number. Public by design; its code lives only on the backend.
NEXT_PUBLIC_AUTH_TEST_PHONE=

# Same value as the backend's REVALIDATE_SECRET. Guards POST /api/revalidate.
REVALIDATE_SECRET=

# The site's public address, for canonical links, the sitemap and share cards.
# The "Site address" in admin Site settings overrides it.
SITE_URL=http://localhost:3000

# Address behind the "Contact the developer" link on the admin seat map screens.
NEXT_PUBLIC_DEVELOPER_CONTACT_EMAIL=

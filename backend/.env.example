PORT=8080
NODE_ENV=development
MONGODB_URI=
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=
AUTH_RELAY_SECRET=
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=
MSG91_EMAIL_OTP_TEMPLATE_ID=
TRUST_PROXY=

# Razorpay. The secret must never reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# S3 image uploads. Leave the keys empty on EC2 or ECS to use the instance role.
# AWS_S3_PUBLIC_BASE_URL is a CDN origin, set only once CloudFront exists.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# Payment gateway review login. Both are required together: the number alone
# never signs anyone in. Remove both once approval is granted.
AUTH_TEST_PHONE=
AUTH_TEST_OTP=

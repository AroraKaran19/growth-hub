PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/growth-hub
# The site's address. Email links and CORS use it.
FRONTEND_URL=http://localhost:3000
# Optional. More browser origins allowed to call the API, comma-separated.
# CORS_ORIGINS=
# Optional. Proxy hops in front of the API, for example 1 behind nginx.
# TRUST_PROXY=
# DB_MAX_POOL_SIZE=5
# DB_MIN_POOL_SIZE=1

# Secrets below need 32+ characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Same value as the frontend's AUTH_RELAY_SECRET.
AUTH_RELAY_SECRET=
# Same value as the frontend's REVALIDATE_SECRET. Unset, site edits take up to 5 minutes to show.
REVALIDATE_SECRET=
# Signs check-in QR codes.
QR_SIGNING_SECRET=
# Optional. Bearer token for GET /api/jobs/tick, if an outside scheduler runs the jobs.
CRON_SECRET=
# Encrypts venue bank details. 32 bytes, base64: openssl rand -base64 32
PAYOUT_ENCRYPTION_KEY=

# MSG91 sends sign-in texts and every email.
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=mail.example.com
MSG91_EMAIL_FROM=noreply@mail.example.com
MSG91_EMAIL_FROM_NAME=Growth Hub

# Optional review sign-in that skips the SMS. Set both or neither, never in production.
# AUTH_TEST_PHONE=
# AUTH_TEST_OTP=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook set up in the Razorpay dashboard. Needed for renewals.
RAZORPAY_WEBHOOK_SECRET=

AWS_REGION=
AWS_S3_BUCKET_NAME=
# Leave both blank on an AWS server with an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. A CDN address for uploaded files, once CloudFront is set up.
# AWS_S3_PUBLIC_BASE_URL=

# Invoice worker. LIBREOFFICE_PATH only if LibreOffice isn't in a standard place.
# LIBREOFFICE_PATH=
# INVOICE_WORKER_POLL_MS=30000
# INVOICE_WORKER_BATCH=5

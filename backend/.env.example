PORT=8080
NODE_ENV=development
MONGODB_URI=
FRONTEND_URL=http://localhost:3000
# Optional. More browser origins allowed to call the API, comma separated, for
# example the www address or a preview deployment. FRONTEND_URL is always allowed.
CORS_ORIGINS=
JWT_ACCESS_SECRET=
AUTH_RELAY_SECRET=
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=
# Admin and partner "forgot password" email; variables name, reset_link, expiry_minutes.
MSG91_EMAIL_PASSWORD_RESET_TEMPLATE_ID=
TRUST_PROXY=

# Razorpay. The secret must never reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Webhooks, for POST /api/webhooks/razorpay. Enable all nine events:
# payment.authorized, payment.captured, subscription.authenticated, subscription.activated,
# subscription.charged, subscription.pending, subscription.halted, subscription.cancelled,
# subscription.completed. Required in production.
RAZORPAY_WEBHOOK_SECRET=

# Signs check-in QR codes. At least 32 characters; required in production.
# Changing it makes every QR code already issued unreadable.
QR_SIGNING_SECRET=
# Vercel Cron sends this as a bearer token to /api/jobs/tick. At least 32
# characters; required in production.
CRON_SECRET=
# Encrypts venue bank account numbers: 32 random bytes, base64. Required in
# production. Changing it makes stored account numbers unreadable.
PAYOUT_ENCRYPTION_KEY=

# S3 image uploads. Leave the keys empty on EC2 or ECS to use the instance role.
# AWS_S3_PUBLIC_BASE_URL is a CDN origin, set only once CloudFront exists.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# Payment gateway review login. Both are required together: the number alone
# never signs anyone in. Remove both once approval is granted.
AUTH_TEST_PHONE=
AUTH_TEST_OTP=

# Shared with the frontend's REVALIDATE_SECRET, at least 32 characters. Lets the
# backend tell the site a venue changed. Required in production; without it in
# development, changes show up after the 5 minute cache expiry.
REVALIDATE_SECRET=

# Optional. Each email is skipped until its MSG91 template id is set. Members
# are only emailed; there are no SMS notices. Template variables:
#   BOOKING_CONFIRMED ref, venue, date, time, amount
#   MEMBERSHIP_STARTED ref, venue, plan, starts, amount
#   ADDON_ORDER_CONFIRMED ref, venue, dates, amount
#   CANCELLATION_DECIDED name, ref, venue, outcome, amount, note
#   RENEWAL_FAILED ref, venue, link
#   MEMBERSHIP_LAPSED ref, venue, ends
#   LATE_PAYMENT_RELEASED ref, venue, amount
#   VENUE_REMOVED ref, venue, reason, amount
#   CANCELLATION_REQUEST (staff email) ref, member, venue, starts, reason, details
#   STATEMENT_ISSUED (staff email) venue, month, total, link
#   STATEMENT_PAID (staff email) venue, month, total, utr, paidOn
#   PAYOUT_ACCOUNT_CHANGED (staff email) venue, bank, last4
MSG91_EMAIL_TEMPLATE_BOOKING_CONFIRMED=
MSG91_EMAIL_TEMPLATE_MEMBERSHIP_STARTED=
MSG91_EMAIL_TEMPLATE_ADDON_ORDER_CONFIRMED=
MSG91_EMAIL_TEMPLATE_CANCELLATION_DECIDED=
MSG91_EMAIL_TEMPLATE_RENEWAL_FAILED=
MSG91_EMAIL_TEMPLATE_MEMBERSHIP_LAPSED=
MSG91_EMAIL_TEMPLATE_LATE_PAYMENT_RELEASED=
MSG91_EMAIL_TEMPLATE_VENUE_REMOVED=
MSG91_EMAIL_TEMPLATE_INVOICE_READY=
MSG91_EMAIL_TEMPLATE_CANCELLATION_REQUEST=
MSG91_EMAIL_TEMPLATE_STATEMENT_ISSUED=
MSG91_EMAIL_TEMPLATE_STATEMENT_PAID=
MSG91_EMAIL_TEMPLATE_PAYOUT_ACCOUNT_CHANGED=

# Invoice worker, optional: LibreOffice path when it is not in a standard place
LIBREOFFICE_PATH=
